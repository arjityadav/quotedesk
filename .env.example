# Copy to .env and fill in what you need: cp .env.example .env
# .env is gitignored. Never commit real keys.
# Keep comments on their own lines: the Makefile loads this file, and make
# treats anything after the value (including spaces before a #) as part of it.

# --- App -------------------------------------------------------------------
# local | staging | production
QUOTEDESK_ENV=local
LOG_LEVEL=INFO

# --- Database (matches deploy/compose/compose.yaml) ------------------------
DATABASE_URL=postgresql://quotedesk:quotedesk@localhost:5432/quotedesk

# --- Model providers (called through LiteLLM) ------------------------------
# Bulk generation, embeddings, reranking, vision
NVIDIA_NIM_API_KEY=
# Hard cases and the eval judge
ANTHROPIC_API_KEY=

# --- Tracing and evals (Langfuse EU region) --------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- External services -----------------------------------------------------
# Datasheet search for out-of-catalog items
EXA_API_KEY=
# Voice agent
ELEVENLABS_API_KEY=
# Shared secret for the email webhook
N8N_WEBHOOK_SECRET=

# --- Auth ------------------------------------------------------------------
# Signs demo invite codes. Generate with: openssl rand -hex 32
JWT_SECRET=

# --- AWS (use a named profile, not access keys) ----------------------------
AWS_PROFILE=
AWS_REGION=eu-central-1
